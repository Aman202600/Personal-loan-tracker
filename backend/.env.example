# MiniLedger Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# For local MongoDB: mongodb://localhost:27017/miniledger
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/miniledger?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/miniledger

# Authentication
# Replace with a strong, random 256-bit secret in production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# OTP Settings
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=5

# Development Mock OTP Workflow
# When true, OTP is printed to the backend console.
# Additionally, an optional fallback mock OTP can be permitted for rapid automated testing.
ALLOW_DEV_MOCK_OTP=true
DEV_MOCK_OTP_CODE=123456

# File Uploads (Receipts)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=5242880

# CORS
CORS_ORIGIN=*
